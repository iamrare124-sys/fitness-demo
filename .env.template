# ============================================================
# APEX FITNESS APP — ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ─── SUPABASE ────────────────────────────────────────────────
# Safe to expose in client (EXPO_PUBLIC_ prefix = bundled into app)
# RLS enforces all data isolation — anon key is safe.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ─── ANALYTICS ───────────────────────────────────────────────
EXPO_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_KEY
EXPO_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ─── SUBSCRIPTIONS ───────────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_KEY_ANDROID=YOUR_REVENUECAT_ANDROID_KEY

# ─── ERROR TRACKING ──────────────────────────────────────────
# Sentry DSN is OK to expose (it only receives errors, not a secret)
SENTRY_DSN=https://YOUR_KEY@YOUR_ORG.ingest.sentry.io/YOUR_PROJECT_ID
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=apex-fitness
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# ─── EAS ─────────────────────────────────────────────────────
EAS_PROJECT_ID=YOUR_EAS_PROJECT_ID

# ─── OPENAI (NEVER USE EXPO_PUBLIC_ PREFIX — SERVER ONLY) ────
# This key MUST live only in Supabase Edge Function environment variables.
# Set it in Supabase Dashboard → Settings → Edge Functions → Secrets.
# OPENAI_API_KEY=sk-... ← DO NOT ADD HERE, set in Supabase Dashboard

# ─── RAZORPAY (SERVER SIDE ONLY) ─────────────────────────────
# Set in Supabase Edge Function secrets, never in client env
# RAZORPAY_KEY_ID=rzp_live_...
# RAZORPAY_KEY_SECRET=...
